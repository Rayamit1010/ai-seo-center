{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/rank-check",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/subscriptions",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/worker",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/purge",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/cron/site-monitor",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/link-monitor",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/citation-monitor",
      "schedule": "0 7 * * *"
    }
  ]
}
